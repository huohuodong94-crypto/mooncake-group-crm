{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mooncake-group-crm-output-schema",
  "title": "门店团购 CRM 抽取记录",
  "description": "店长语音/文字 → 一条结构化抽取记录。由 Agent 严格按本契约产出 JSON；validate 脚本校验通过、店长确认后，引擎才写入双表台账。字段名与《月饼哥哥_团购客户管理双表模板》的列一一对应（英文键 → 中文列，见 crm-rules.json 的 export 段）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "description": "本次话语的动作意图（引擎据此分派模式）",
      "enum": [
        "add_customer",
        "update_opportunity",
        "log_followup",
        "close_deal",
        "set_next",
        "query",
        "update_payment",
        "update_delivery"
      ]
    },
    "recorded_at": {
      "type": "string",
      "description": "话语发生日期 YYYY-MM-DD（默认今天）",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "store": {
      "type": "string",
      "description": "所属门店",
      "maxLength": 40
    },
    "owner": {
      "type": "string",
      "description": "跟进人（店长/团购跟进人）",
      "maxLength": 20
    },
    "source": {
      "type": "string",
      "description": "线索来源（V1.2 三值；原模板“主动开发”映射为“新获客”）",
      "enum": [
        "新获客",
        "老客转介绍",
        "老客续费"
      ]
    },
    "match": {
      "type": "object",
      "description": "定位目标：update/log_followup/close_deal/set_next 必填其一；add_customer 可选（用于去重预检）",
      "additionalProperties": false,
      "properties": {
        "opp_id": {
          "type": "string",
          "pattern": "^MO-\\d{4}-\\d{4}$"
        },
        "cust_id": {
          "type": "string",
          "pattern": "^KH-\\d{4}-\\d{4}$"
        },
        "customer_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "contact_phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "customer": {
      "type": "object",
      "description": "客户档案字段（总部客户档案表 + 商机表上的联系人信息）",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "short_name": {
          "type": "string",
          "maxLength": 20
        },
        "contact": {
          "type": "string",
          "description": "主联系人/联系人",
          "maxLength": 20
        },
        "contact_phone": {
          "type": "string",
          "description": "联系电话/微信（可为手机号或微信号）",
          "minLength": 1,
          "maxLength": 40
        },
        "customer_type": {
          "type": "string",
          "enum": [
            "企业客户",
            "政府/事业单位",
            "协会/商会",
            "渠道客户",
            "个人团购",
            "其他"
          ]
        },
        "industry": {
          "type": "string",
          "maxLength": 40
        },
        "customer_level": {
          "type": "string",
          "enum": [
            "核心客户",
            "重点客户",
            "一般客户",
            "潜在客户"
          ]
        },
        "region": {
          "type": "string",
          "maxLength": 60
        },
        "address": {
          "type": "string",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "description": "主联系人职务",
          "maxLength": 30
        },
        "other_contacts": {
          "type": "string",
          "maxLength": 120
        },
        "preference": {
          "type": "string",
          "description": "客户偏好",
          "maxLength": 200
        },
        "tags": {
          "type": "string",
          "description": "重要客户标签",
          "maxLength": 120
        },
        "customer_status": {
          "type": "string",
          "enum": [
            "活跃",
            "待激活",
            "沉睡",
            "流失"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "opportunity": {
      "type": "object",
      "description": "商机字段（门店客户商机表）",
      "additionalProperties": false,
      "properties": {
        "customer_need": {
          "type": "string",
          "description": "客户需求（如：员工中秋福利，预算约150元/份）",
          "minLength": 1,
          "maxLength": 200
        },
        "product": {
          "type": "string",
          "description": "意向产品（自由文本；报价时交给报价 Skill 匹配）",
          "maxLength": 60
        },
        "quantity": {
          "type": "integer",
          "description": "意向数量",
          "minimum": 1
        },
        "intent_level": {
          "type": "string",
          "description": "意向等级",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "expected_amount": {
          "type": "number",
          "description": "预计金额（元）",
          "minimum": 0
        },
        "stage": {
          "type": "string",
          "description": "当前阶段（V1.2 七态，线性流转：初次接触→需求确认→方案报价→谈判中→已签约→已回款；已流失为终态，不得跳态或回退）",
          "enum": [
            "初次接触",
            "需求确认",
            "方案报价",
            "谈判中",
            "已签约",
            "已回款",
            "已流失"
          ]
        },
        "next_follow_date": {
          "type": "string",
          "description": "下次跟进日期 YYYY-MM-DD",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "customer_address": {
          "type": "string",
          "description": "联系人所在地址（非配送地址）",
          "maxLength": 120
        },
        "demand_category": {
          "type": "string",
          "description": "需求品类",
          "enum": [
            "散装",
            "68礼盒",
            "98礼盒",
            "138礼盒",
            "定制礼盒",
            "待定"
          ]
        },
        "payment_date": {
          "type": "string",
          "description": "回款日期 YYYY-MM-DD（阶段=已回款 时必填）",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "payment_amount": {
          "type": "number",
          "description": "回款金额（元）",
          "minimum": 0
        },
        "delivery_date": {
          "type": "string",
          "description": "交付/配送日期 YYYY-MM-DD",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        }
      }
    },
    "follow_up": {
      "type": "object",
      "description": "本次跟进记录（最新一条会回写到商机表“最近跟进情况”）",
      "additionalProperties": false,
      "properties": {
        "followed_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "content": {
          "type": "string",
          "description": "本次跟进情况",
          "minLength": 1,
          "maxLength": 500
        },
        "customer_feedback": {
          "type": "string",
          "description": "客户反馈",
          "maxLength": 300
        },
        "next_action": {
          "type": "string",
          "description": "下一步动作",
          "maxLength": 200
        }
      }
    },
    "deal": {
      "type": "object",
      "description": "成交/流失信息（close_deal 时填；回款状态仅引擎内部与复盘使用，不是双表列）",
      "additionalProperties": false,
      "properties": {
        "deal_date": {
          "type": "string",
          "description": "成交日期 YYYY-MM-DD",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "deal_amount": {
          "type": "number",
          "description": "成交金额（元）",
          "minimum": 0
        },
        "payment_status": {
          "type": "string",
          "description": "回款状态（内部分层：签约未回款/部分回款/已回款）",
          "enum": [
            "未回款",
            "部分回款",
            "已回款"
          ]
        },
        "lost_reason": {
          "type": "string",
          "description": "流失原因（阶段=已流失 时填）",
          "maxLength": 120
        }
      }
    }
  }
}
